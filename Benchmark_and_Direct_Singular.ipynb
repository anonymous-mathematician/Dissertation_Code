              "summary": "{\n  \"name\": \"display(reference_uncertainty\",\n  \"rows\": 8,\n  \"fields\": [\n    {\n      \"column\": \"Time\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.36936238496708274,\n        \"min\": 0.0,\n        \"max\": 1.0,\n        \"num_unique_values\": 8,\n        \"samples\": [\n          0.2,\n          0.9,\n          0.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Mean Monte Carlo SE\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.0033039712900862633,\n        \"min\": 0.0,\n        \"max\": 0.009544,\n        \"num_unique_values\": 8,\n        \"samples\": [\n          0.008908,\n          0.003772,\n          0.009544\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Maximum Monte Carlo SE\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.00524377718109761,\n        \"min\": 0.0,\n        \"max\": 0.015938,\n        \"num_unique_values\": 8,\n        \"samples\": [\n          0.013642,\n          0.015676,\n          0.013396\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
            }
